# ---- Terraform ----
.terraform/
# State holds secrets (AD admin password, Ansible private key) - never commit it
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Plans can contain sensitive values
tfplan
*.tfplan
# Real variable values; terraform.tfvars.example is the committed template
*.tfvars
*.tfvars.json
!terraform.tfvars.example
# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Keep .terraform.lock.hcl committed: it pins provider versions

# ---- Ansible ----
# Generated by Terraform from templates/inventory.ini.tftpl
ansible/inventory.ini
*.retry
.ansible/

# ---- Secrets that should never land in the repo ----
*.ovpn
*.pem
*.key
id_ansible*
.doclab-secrets/
.vault_pass*

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
*~
*.iml
