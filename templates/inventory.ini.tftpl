# Generated by Terraform - do not edit by hand
%{ for group, members in groups ~}
[${group}]
%{ for m in members ~}
${fqdns[m]} ansible_host=${ips[m]}
%{ endfor ~}

%{ endfor ~}
[all:vars]
ansible_user=ec2-user
ansible_become=true
ansible_ssh_private_key_file=/home/ec2-user/.ssh/id_ansible
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
graylog_host=${graylog_ip}
graylog_syslog_port=1514
ipa_server_fqdn=${ipa_server}
ipaserver_domain=${ipa_domain}
ipaserver_realm=${ipa_realm}
ipaclient_domain=${ipa_domain}
ipaclient_realm=${ipa_realm}
ad_domain=${ad_domain}
ad_enabled=${ad_enabled}
vpc_cidr=${vpc_cidr}
vpc_netmask=${vpc_mask}
vpc_dns=${vpc_dns}
# Passwords are generated on rhel-server under ~/.doclab-secrets by the playbooks, not stored here.
